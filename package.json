{
  "name": "swiss-parcs-ims",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "services:start": "docker compose -f docker-compose.dev.yml up -d --remove-orphans && bash scripts/garage-init.sh",
    "garage:init": "bash scripts/garage-init.sh",
    "services:stop": "docker compose -f docker-compose.dev.yml down --remove-orphans",
    "services:destroy": "docker compose -f docker-compose.dev.yml down --volumes --remove-orphans",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "yarn run lint && cross-env NODE_OPTIONS=--no-deprecation next build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "prettier": "prettier --write --list-different --cache --cache-location ./node_modules/.cache/prettier .",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "generate:types": "payload generate:types",
    "generate:importMap": "payload generate:importMap",
    "smoke:access": "node --experimental-strip-types --no-warnings ./src/scripts/smoke-access-control.ts",
    "clone:cleanup": "tsx ./src/scripts/delete-clone-test-rows.ts",
    "email:dev": "email dev",
    "email:export": "email export",
    "typecheck": "npx tsc --noEmit",
    "check": "yarn typecheck && yarn lint && yarn test",
    "up": "yarn upgrade-interactive",
    "self-update": "yarn set version latest && yarn",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@faceless-ui/modal": "3.0.1",
    "@faceless-ui/scroll-info": "2.0.0",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/email-nodemailer": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/plugin-cloud-storage": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-s3": "3.90.1",
    "@payloadcms/ui": "patch:@payloadcms/ui@npm%3A3.90.1#~/.yarn/patches/@payloadcms-ui-npm-3.90.1-a531f1acda.patch",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-pdf/renderer": "4.9.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "date-fns": "4.4.0",
    "deepl-node": "^1.28.0",
    "es-toolkit": "^1.52.0",
    "graphql": "^16.14.2",
    "he": "^1.2.0",
    "ky": "^2.1.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "payload": "3.90.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.9.5",
    "sharp": "^0.35.4",
    "tslog": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/he": "^1.2.3",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "autoprefixer": "^10.6.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^71.1.0",
    "postcss": "^8.5.28",
    "postcss-nested": "^6.2.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "@payloadcms/ui@npm:3.90.1": "patch:@payloadcms/ui@npm%3A3.90.1#~/.yarn/patches/@payloadcms-ui-npm-3.90.1-a531f1acda.patch"
  }
}
