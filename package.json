{
  "name": "swiss-parcs-ims",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "services:start": "docker compose -f docker-compose.dev.yml up -d --remove-orphans && bash scripts/garage-init.sh",
    "garage:init": "bash scripts/garage-init.sh",
    "services:stop": "docker compose -f docker-compose.dev.yml down --remove-orphans",
    "services:destroy": "docker compose -f docker-compose.dev.yml down --volumes --remove-orphans",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "yarn run lint && cross-env NODE_OPTIONS=--no-deprecation next build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "prettier": "prettier --write --list-different --cache --cache-location ./node_modules/.cache/prettier .",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "generate:types": "payload generate:types",
    "generate:importMap": "payload generate:importMap",
    "standalone-script": "tsx ./src/scripts/standalone-script.ts",
    "email:dev": "email dev",
    "email:export": "email export",
    "typecheck": "npx tsc --noEmit",
    "check": "yarn typecheck && yarn lint && yarn test",
    "up": "yarn upgrade-interactive",
    "self-update": "yarn set version latest && yarn",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@faceless-ui/modal": "3.0.0",
    "@faceless-ui/scroll-info": "2.0.0",
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/email-nodemailer": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/plugin-nested-docs": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/richtext-slate": "3.87.1",
    "@payloadcms/storage-s3": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "deepl-node": "^1.27.0",
    "es-toolkit": "^1.50.0",
    "form-data": "^4.0.6",
    "graphql": "^16.14.2",
    "he": "^1.2.0",
    "ky": "^1.14.3",
    "lucide-react": "^0.556.0",
    "next": "16.3.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.13",
    "payload": "3.87.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.2",
    "sharp": "^0.34.5",
    "tslog": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/he": "^1.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^71.1.0",
    "jest": "^30.4.2",
    "jest-environment-node": "30.4.1",
    "postcss": "^8.5.26",
    "postcss-nested": "^6.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "yarn@4.18.0"
}
